{
  "_comment": "Configuration file for the nori-embb-urllc-scenario. All values use SI units unless otherwise noted.",
  "controlMode": "none",
  "topology": {
    "_comment": "Explicit gNB positions and uniform UE placement use SI units.",
    "numGNb": 1,
    "gnbPositions": [
      {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
      }
    ],
    "uePositionArea": {
      "mode": "uniform-rectangle",
      "xMin": -20.0,
      "xMax": 20.0,
      "yMin": -20.0,
      "yMax": 20.0,
      "height": 0.0
    }
  },
  "mobility": {
    "_comment": "UE mobility model and model-specific parameters.",
    "model": "random-waypoint",
    "speed": {
      "min": 5.0,
      "max": 15.0
    },
    "pause": 0.0
  },
  "channel": {
    "_comment": "3GPP propagation, channel condition and fast-fading parameters.",
    "scenario": "UMa",
    "condition": "Default",
    "model": "ThreeGpp",
    "shadowingEnabled": false,
    "conditionUpdatePeriod": 0.0,
    "channelUpdatePeriod": 0.0
  },
  "antennas": {
    "_comment": "gNB and UE arrays plus their shared beamforming behavior.",
    "gnb": {
      "rows": 1,
      "columns": 1,
      "horizontalPorts": 1,
      "verticalPorts": 1,
      "dualPolarized": false,
      "elementModel": "Isotropic"
    },
    "ue": {
      "rows": 1,
      "columns": 1,
      "horizontalPorts": 1,
      "verticalPorts": 1,
      "dualPolarized": false,
      "elementModel": "Isotropic"
    },
    "beamforming": {
      "mode": "quasi-omni",
      "updatePeriod": 0.0
    }
  },
  "mimo": {
    "_comment": "Downlink MIMO feedback and RI/PMI search parameters.",
    "enabled": false,
    "csiFeedbackFlags": 1,
    "widebandPmiUpdateInterval": 0.01,
    "subbandPmiUpdateInterval": 0.002,
    "pmSearchMethod": "Full",
    "codebook": "TwoPort",
    "rankLimit": 1,
    "subbandSize": 4,
    "downsamplingTechnique": "FirstPRB"
  },
  "simulation": {
    "_comment": "Global simulation parameters.",
    "duration": 5,
    "rngSeed": 1,
    "rngRun": 1
  },
  "NR": {
    "_comment": "Physical parameters of the NR cell.",
    "numerology": 1,
    "bandwidthMHz": 100,
    "centralFrequency": 3500000000.0,
    "txPower": 50,
    "ueTxPower": 23
  },
  "traffic": {
    "_comment": "Application traffic profiles. For direction=bidirectional, bitrateMbps is offered independently in each direction.",
    "eMBB": {
      "_comment": "eMBB traffic: high throughput, less strict delay constraints.",
      "protocol": "udp",
      "direction": "downlink",
      "packetSize": 1400,
      "bitrateMbps": 100,
      "startTime": 2.0,
      "stopTime": 5.0,
      "onTime": {
        "distribution": "exponential",
        "mean": 1.0
      },
      "offTime": {
        "distribution": "exponential",
        "mean": 0.0
      }
    },
    "URLLC": {
      "_comment": "URLLC traffic: lower throughput, higher reliability/low latency.",
      "protocol": "udp",
      "direction": "downlink",
      "packetSize": 1400,
      "bitrateMbps": 15,
      "startTime": 2.0,
      "stopTime": 5.0,
      "onTime": {
        "distribution": "exponential",
        "mean": 1.0
      },
      "offTime": {
        "distribution": "exponential",
        "mean": 0.01
      }
    }
  },
  "qos": {
    "_comment": "Per-profile bearers and RLC policy; the current slicing scheduler does not enforce 5QI priority, PDB or GBR across UEs.",
    "release": 18,
    "rlc": {
      "_comment": "ns3-default resolves to RLC UM when EPC is enabled.",
      "mapping": "ns3-default",
      "umMaxTxBufferSize": 10240,
      "amMaxTxBufferSize": 10240
    },
    "bearers": {
      "_comment": "Bearer names must match the configured traffic profiles.",
      "eMBB": {
        "qci": "NGBR_LOW_LAT_EMBB",
        "gbrDl": 0,
        "gbrUl": 0,
        "mbrDl": 0,
        "mbrUl": 0,
        "arp": {
          "enabled": false,
          "priorityLevel": 0,
          "preemptionCapability": false,
          "preemptionVulnerability": false
        }
      },
      "URLLC": {
        "qci": "NGBR_LOW_LAT_EMBB",
        "gbrDl": 0,
        "gbrUl": 0,
        "mbrDl": 0,
        "mbrUl": 0,
        "arp": {
          "enabled": false,
          "priorityLevel": 0,
          "preemptionCapability": false,
          "preemptionVulnerability": false
        }
      }
    }
  },
  "slices": {
    "_comment": "RAN slicing configuration: number of UEs per slice and associated traffic type.",
    "numSlices": 2,
    "UesPerSlice": [
      2,
      2
    ],
    "trafficTypes": [
      "eMBB",
      "URLLC"
    ],
    "SstPerSlice": [
      1,
      2
    ]
  }
}
